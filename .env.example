DATABASE_URL=postgresql://agent:change-me@localhost:5432/personal_agent
APP_URL=http://localhost:6797
BETTER_AUTH_SECRET=
MASTER_KEY=
INSTALL_ID=
ARTIFACT_DIR=./data/artifacts
WORKSTATION_IMAGE=owndesk-workstation:0.7.0
# The workstation speaks Chinese (zh_CN.UTF-8, Asia/Shanghai) unless overridden here.
# Built-in locales: zh_CN.UTF-8, en_US.UTF-8.
# WORKSTATION_LOCALE=en_US.UTF-8
# WORKSTATION_TZ=America/New_York
WORKER_PORT=6798
# Stop finished idle desktops after this many minutes; 0 keeps them running.
WORKSTATION_IDLE_MINUTES=15
# Conservative context window for the selected model/gateway; includes output reserve.
PA_CONTEXT_WINDOW_TOKENS=65536
# Optional; can also be configured in the owner settings page.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_URL=https://api.telegram.org
# Web Push (npm run push:keys). Keep across upgrades.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Models (BYOK). Examples: DeepSeek, or any OpenAI-compatible endpoint via custom provider in Settings.
# DEEPSEEK_API_KEY=
# OWNDESK_DEFAULT_MODEL=deepseek/deepseek-chat
# OWNDESK_CHAT_MODEL=deepseek/deepseek-chat
# OWNDESK_FALLBACK_MODEL=custom/your-backup-model

# Only for a trusted Clash/mihomo fake-IP proxy. MCP/OAuth hostname DNS answers
# in 198.18.0.0/15 only; literal IP URLs and other private ranges stay blocked.
MCP_ALLOW_FAKE_IP=false
